# Add these values to the existing live backend .env without replacing its
# database, authentication, email or storage settings. Never use VITE_* keys.
PAYMENT_PROVIDER=hesabe
HESABE_ENVIRONMENT=sandbox
HESABE_SANDBOX_ON_LIVE_SITE=true
FRONTEND_URL=https://vaypr.net
HESABE_CALLBACK_BASE_URL=https://api.vaypr.net
# Obtain the public test merchant values from Hesabe's Sandbox Environment page.
HESABE_MERCHANT_CODE=
HESABE_ACCESS_CODE=
HESABE_SECRET_KEY=
HESABE_IV_KEY=
